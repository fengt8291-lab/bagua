/* 起卦工具样式 */

.container {
  min-height: 100vh;
  background: #f5f0e8;
  color: #2d2d2d;
  font-family: -apple-system, sans-serif;
}

/* ===== 介绍页 ===== */
.intro-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 60rpx;
}

.intro-icon {
  font-size: 120rpx;
  margin-bottom: 40rpx;
  opacity: 0.8;
}

.intro-title {
  font-size: 56rpx;
  font-weight: 700;
  color: #2d2d2d;
  margin-bottom: 16rpx;
}

.intro-subtitle {
  font-size: 28rpx;
  color: #888;
  margin-bottom: 60rpx;
}

.intro-desc {
  text-align: center;
  font-size: 30rpx;
  color: #666;
  line-height: 1.8;
  margin-bottom: 80rpx;
  white-space: pre-line;
}

.start-btn {
  width: 100%;
  background: #c9a96e;
  color: #fff;
  font-size: 34rpx;
  font-weight: 600;
  padding: 28rpx 0;
  border-radius: 60rpx;
  border: none;
  margin-bottom: 30rpx;
}

.start-btn::after { border: none; }

.intro-note {
  font-size: 24rpx;
  color: #aaa;
}

/* ===== 问题输入页 ===== */
.input-page {
  padding: 80rpx 50rpx 50rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 16rpx;
  color: #2d2d2d;
}

.input-tip {
  text-align: center;
  font-size: 26rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.question-input {
  width: 100%;
  height: 240rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  font-size: 30rpx;
  line-height: 1.8;
  box-sizing: border-box;
  border: 2rpx solid #e8e0d5;
  color: #2d2d2d;
}

.char-count {
  text-align: right;
  font-size: 24rpx;
  color: #bbb;
  margin-top: 12rpx;
  margin-bottom: 50rpx;
}

.confirm-btn {
  width: 100%;
  background: #c9a96e;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  padding: 28rpx 0;
  border-radius: 60rpx;
  border: none;
}

.confirm-btn::after { border: none; }

.back-btn {
  text-align: center;
  font-size: 28rpx;
  color: #999;
  margin-top: 40rpx;
  padding: 20rpx;
}

/* ===== 掷卦动画页 ===== */
.tossing-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 50rpx;
}

.toss-title {
  font-size: 32rpx;
  color: #666;
  margin-bottom: 60rpx;
  text-align: center;
}

.toss-progress {
  font-size: 80rpx;
  font-weight: 700;
  color: #c9a96e;
  margin-bottom: 50rpx;
}

.toss-visual {
  margin-bottom: 40rpx;
}

.coin-row {
  display: flex;
  gap: 30rpx;
}

.coin {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 700;
  border: 4rpx solid #c9a96e;
}

.coin.yang {
  background: #fff8e6;
  color: #c9a96e;
}

.coin.yin {
  background: #f0f0f0;
  color: #888;
}

.coin.empty {
  background: #f5f0e8;
  color: #ccc;
  border-color: #ddd;
}

.toss-hint {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 60rpx;
}

.loading-dots {
  display: flex;
  gap: 16rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #c9a96e;
  animation: dotPulse 1.2s infinite;
}

.dot:nth-child(2) { animation-delay: 0.2s; }
.dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes dotPulse {
  0%, 100% { opacity: 0.3; transform: scale(0.8); }
  50% { opacity: 1; transform: scale(1.2); }
}

/* ===== 结果页 ===== */
.result-page {
  padding: 60rpx 50rpx 100rpx;
}

.result-header {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 50rpx;
}

.hexagram-name {
  font-size: 64rpx;
  font-weight: 700;
  color: #2d2d2d;
}

.hexagram-arrow {
  font-size: 48rpx;
  color: #999;
  margin: 0 20rpx;
}

.hexagram-name.changed {
  color: #c9a96e;
}

.lines-display {
  background: #fff;
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.line-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0ebe3;
}

.line-item:last-child {
  border-bottom: none;
}

.line-name {
  width: 80rpx;
  font-size: 26rpx;
  color: #999;
}

.line-symbol {
  font-size: 40rpx;
  font-weight: 700;
  width: 60rpx;
  text-align: center;
}

.line-symbol.yang { color: #c9a96e; }
.line-symbol.yin { color: #888; }
.line-symbol.old { opacity: 0.6; }

.line-text {
  flex: 1;
  font-size: 26rpx;
  color: #666;
  text-align: right;
}

.result-card {
  background: #fff8e6;
  border-radius: 24rpx;
  padding: 40rpx;
  margin-bottom: 40rpx;
}

.result-label {
  font-size: 26rpx;
  color: #c9a96e;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.result-interpretation {
  font-size: 30rpx;
  color: #2d2d2d;
  line-height: 1.9;
  white-space: pre-wrap;
}

.banner-ad-container {
  width: 100%;
  margin-bottom: 30rpx;
  display: flex;
  justify-content: center;
}

.share-btn {
  width: 100%;
  background: #c9a96e;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  padding: 28rpx 0;
  border-radius: 60rpx;
  border: none;
  margin-bottom: 20rpx;
}

.share-btn::after { border: none; }

.replay-btn {
  text-align: center;
  font-size: 28rpx;
  color: #999;
  padding: 20rpx;
}
