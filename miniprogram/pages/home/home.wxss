.container {
  min-height: 100vh;
  background: #f5f0e8;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 50rpx;
  font-family: -apple-system, sans-serif;
}

.header {
  text-align: center;
  margin-bottom: 80rpx;
}

.title {
  font-size: 56rpx;
  font-weight: 700;
  color: #2d2d2d;
  margin-bottom: 16rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #999;
}

.cards {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 50rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  border: 2rpx solid #e8e0d5;
}

.card:active {
  opacity: 0.8;
}

.card-icon {
  font-size: 72rpx;
  margin-bottom: 20rpx;
}

.card-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #2d2d2d;
  margin-bottom: 12rpx;
}

.card-desc {
  font-size: 26rpx;
  color: #999;
  text-align: center;
}
